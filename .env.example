# LLM for intake + survey writing (optional; rule-based fallback without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Idealista official API (optional)
IDEALISTA_API_KEY=
IDEALISTA_SECRET=

# Which sources to query (comma-separated):
#   demo        synthetic Madrid data; only shown when no real source returns anything
#   spotahome   scraper, no key, rent only
#   habitaclia  scraper, no key, rent + buy
#   pisos       scraper, no key, but often blocked -> set CASA_BROWSER_FALLBACK=1
#   fotocasa    scraper, no key, often blocked
#   idealista   official API, needs the keys above
CASA_SOURCES=spotahome,habitaclia,pisos,fotocasa,demo
CASA_BROWSER_FALLBACK=1

# How many options to put in the survey
CASA_TOP_N=8
